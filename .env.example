# ========================================================
# 1. สำหรับเชื่อมต่อกับ XAMPP (MySQL Port 3306, ค่าเริ่มต้นไม่มีรหัสผ่าน)
# ========================================================
DATABASE_URL="mysql://root:@127.0.0.1:3306/manga_db"

# ========================================================
# 2. สำหรับเชื่อมต่อกับ Docker MariaDB (เมื่อรัน npm run dev บนเครื่อง Host ผ่าน Port 3307)
# DATABASE_URL="mysql://root:rootpassword@127.0.0.1:3307/manga_db"
# ========================================================

DATABASE_HOST="127.0.0.1"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="manga_db"

# คีย์สำหรับเข้ารหัส JWT Token (Login / Register)
JWT_SECRET="manga_secret_key_jwt_super_secure_2026"
